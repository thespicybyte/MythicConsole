.login_screen {
    align: center middle
}

.login_box {
    align: center middle;
    height: 20;
    max-width: 50%;
    background: $panel;
    color: $text;
    border: wide $accent 100%;
    padding: 1 2;
}

.login_box > Input {
    margin: 1 0 0 0;
    border: tall $panel 100%;
    &:focus {
        text-style: bold;
    }

    &:dark {
        &:focus {
            background: $panel-lighten-1;
            border: tall $panel-lighten-3 100%;
        }

    }

    &:light {
        &:focus {
            background: $panel-darken-1;
            border: tall $panel-darken-3 100%;
        }

    }
}

.login_box > Button {
    width: 100w;
    margin: 1 0 0 0;

    &:dark {
        background: $accent;
        border: $accent;
        &:hover {
            background: $accent-lighten-1;
            border: tall $accent-lighten-3 100%;
            color: $text;
            text-style: bold;
        }
        &:focus {
            text-style: bold;
            background: $accent-lighten-1;
            border: tall $accent-lighten-3 100%;
        }
    }

    &:light {
        background: $accent-lighten-1;
        border: $accent-lighten-1;

        &:hover {
            background: $accent-darken-1;
            border: tall $accent-darken-3 100%;
            color: $text;
            text-style: bold;
        }
        &:focus {
            text-style: bold;
            background: $accent-darken-1;
            border: tall $accent-darken-3 100%;
        }
    }


}

Sidebar {
    width: 35%;
    height: 100%;
    dock: left;
    background: $panel;
    margin: 1 0 0 0;
}

Sidebar.-hidden {
    display: none;
}

LogViewer {
    width: 100%;
    height: 40%;
    dock: bottom;
    background: $panel;
    border: $accent;
    border-title-align: left;
}

LogViewer.-hidden {
    display: none;
}

LogViewer > ConsoleOutput {
    border: none;
}

LogViewer > #log_filter {
    dock: top;
    background: $panel;
    border: solid $primary-background-lighten-1 100%;
}

LogViewer > #log_filter:focus {
    border: solid $primary 100%;
}

LogViewer > #log_filter.-invalid {
    border: solid $error 100%;
}

LogViewer > #log_filter.-hidden {
    display: none;
}

LogLevelMenu {
    align: center middle;
}

LogLevelMenu > Container {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
}

LogLevelMenu > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

LogLevelMenu > Container > CheckSelectionList {
    width: 20;
    height: auto;
    margin: 1 0 0 0;
    border: solid $primary-background-lighten-1 100%;
    background: $panel;
}

SidebarModule {
    border: $accent;
    margin: 1;
    max-height: 12;
    min-height: 12;
}

TasksTable {
    height: 1fr;
    min-height: 12;
    max-height: 100%;
}

CallbackTable, TasksTable DataTable {
    background: $panel;
}

CallbackTable > .datatable--header, TasksTable DataTable > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

CallbackTable > .datatable--odd-row, TasksTable DataTable > .datatable--odd-row {
    background: $panel;
}

CallbackTable > .datatable--even-row, TasksTable DataTable > .datatable--even-row {
    background: $panel-lighten-1;
}

CallbackTable > .datatable--cursor, TasksTable DataTable > .datatable--cursor {
    background: $primary 25%;
}

CallbackTable > .datatable--hover, TasksTable DataTable > .datatable--hover {
    background: $panel-lighten-1 50%;
}

SessionInfo {
    border: $accent;
    margin: 1;
    max-height: 15;
    border-title-align: left;
}

ConsolePanel > Container > Vertical > ConsoleInput {
    height: auto;
    min-height: 3;
    max-height: 10;
    content-align: left middle;
    dock: bottom;
    border: solid $background-lighten-3 100%;
    padding: 0 1;
    &:focus {
        border: solid $primary-background-lighten-3 100%;
    }
}

YesNoPrompt {
    align: center middle;
}

YesNoPrompt > Container {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
}

YesNoPrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

YesNoPrompt > Container > Horizontal {
    width: auto;
    height: auto;
}

YesNoPrompt > Container > Horizontal > Button {
    margin: 1 0 0 2;
}

YesNoPrompt > Container > Horizontal > Button:focus {
    text-style: none;
}

FilePrompt {
    align: center middle;
}

FilePrompt > Container {
    width: 80%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

FilePrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

FilePrompt > Container > DirectoryTree {
    width: 100%;
    height: 1fr;
    border: solid $primary-background-lighten-1 100%;
    margin: 1 0;
}

FilePrompt > Container > Horizontal {
    width: auto;
    height: auto;
}

FilePrompt > Container > Horizontal > Button {
    margin: 1 0 0 0;
}

ManageCallbacks {
    align: center middle;
}

ManageCallbacks > Container {
    width: 90%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

ManageCallbacks > Container > #title {
    width: 100%;
    content-align-horizontal: center;
}

ManageCallbacks #panes {
    height: 1fr;
}

ManageCallbacks #shown_pane,
ManageCallbacks #hidden_pane {
    width: 1fr;
    height: 100%;
}

ManageCallbacks #shown_list,
ManageCallbacks #hidden_list {
    height: 1fr;
    border: solid $primary-background-lighten-1 100%;
    /* Match the option rows so the list has no inner ring/second border. */
    background: $panel;
}

ManageCallbacks #shown_filter,
ManageCallbacks #hidden_filter {
    margin: 0 0 1 0;
    background: $panel;
    border: solid $primary-background-lighten-1 100%;
}

ManageCallbacks #shown_filter:focus,
ManageCallbacks #hidden_filter:focus {
    background: $panel;
    border: solid $primary 100%;
}

ManageCallbacks #shown_header,
ManageCallbacks #hidden_header {
    color: $text-muted;
    text-style: bold;
    margin: 0;
    /* Match the list's left border (1) + option padding (1) so the header
       columns line up with the rows below. */
    padding: 0 0 0 2;
}

ManageCallbacks Checkbox {
    border: none;
    background: $panel;
}

ManageCallbacks Checkbox:focus {
    background: $panel;
    background-tint: $panel 0%;
    border: none;
}

ManageCallbacks Checkbox:focus > .toggle--label {
    color: $text;
    background: $panel;
    text-style: none;
}

ManageCallbacks Checkbox > .toggle--button {
    color: $text-muted;
    background: $panel;
}

ManageCallbacks Checkbox.-on > .toggle--button {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

ManageCallbacks SelectionList > .selection-list--button,
ManageCallbacks SelectionList > .selection-list--button-highlighted {
    color: $text-muted;
    background: $panel;
}

ManageCallbacks SelectionList > .selection-list--button-selected,
ManageCallbacks SelectionList > .selection-list--button-selected-highlighted {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

/* Selection is shown by the checkbox only: no cursor/hover highlight band. */
ManageCallbacks SelectionList > .option-list--option,
ManageCallbacks SelectionList > .option-list--option-highlighted,
ManageCallbacks SelectionList > .option-list--option-hover {
    background: $panel;
    color: $text;
    text-style: none;
}

ManageCallbacks #move_buttons {
    width: auto;
    height: 100%;
    align: center middle;
    margin: 0 2;
}

ManageCallbacks #move_buttons > Button {
    width: 5;
    min-width: 5;
    margin: 1 0;
    color: $text;
    background: $panel;
    border: tall $primary-background-lighten-1;
}

ManageCallbacks #move_buttons > Button:hover {
    background: $primary-background-lighten-1;
    border: tall $primary-background-lighten-1;
}

ManageCallbacks #move_buttons > Button:focus {
    background: $panel;
    /* Keep the normal border on focus (no blue accent), and don't
       reverse/highlight the arrow glyph when the button holds focus. */
    border: tall $primary-background-lighten-1;
    text-style: none;
}

ManageCallbacks #actions {
    width: auto;
    height: auto;
    align: center middle;
}

ManageCallbacks #actions > Button {
    margin: 1 1 0 1;
}

ConsoleOutput {
    width: 1fr;
    height: 1fr;

    &:dark {
        border: solid $primary-background-lighten-1 100%;
    }

    &:light {
        border: solid $background-darken-1;
    }
}

CallbackTabs {
    background: $surface;
    & > ContentTabs {
        background: $surface;
    }
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface-lighten-1 50%;
    scrollbar-background-active: $surface-lighten-1 50%;
    scrollbar-color: $surface;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-corner-color: $surface;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

.-scrolling {
    scrollbar-background: $surface-lighten-1 50%;
    scrollbar-color: $primary;
    scrollbar-size-vertical: 2;
    scrollbar-size-horizontal: 1;
}

Sidebar VerticalScroll, CallbackTable, TasksTable DataTable {
    scrollbar-background: $panel;
    scrollbar-background-hover: $panel-lighten-1 50%;
    scrollbar-background-active: $panel-lighten-1 50%;
    scrollbar-color: $panel;
    scrollbar-corner-color: $panel;
}

Sidebar VerticalScroll.-scrolling, CallbackTable.-scrolling, TasksTable DataTable.-scrolling {
    scrollbar-background: $panel-lighten-1 50%;
    scrollbar-color: $primary;
}

TextPrompt {
    align: center middle;
}

TextPrompt > Container {
    width: 60%;
    height: auto;
    padding: 1 2;
    background: $panel;
}

TextPrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

TextPrompt > Container > #description {
    color: $text-muted;
}

TextPrompt > Container > Input {
    margin: 1 0 0 0;
}

TextPrompt > Container > Horizontal {
    width: auto;
    height: auto;
}

TextPrompt > Container > Horizontal > Button {
    margin: 1 0 0 0;
}

/* Generic CheckSelectionList: selection is shown by the checkbox glyph only.
   Muted box when unchecked, success when checked, and no full-row highlight
   band in any state (including when the list is focused). These live at app
   scope so they beat Textual's own `OptionList:focus` default rule. */
CheckSelectionList > .selection-list--button,
CheckSelectionList > .selection-list--button-highlighted {
    color: $text-muted;
    background: transparent;
}

CheckSelectionList > .selection-list--button-selected,
CheckSelectionList > .selection-list--button-selected-highlighted {
    color: $text-success;
    background: transparent;
    text-style: bold;
}

CheckSelectionList > .option-list--option,
CheckSelectionList > .option-list--option-highlighted,
CheckSelectionList > .option-list--option-hover,
CheckSelectionList:focus > .option-list--option-highlighted {
    background: transparent;
    color: $text;
    text-style: none;
}

ChoicePrompt {
    align: center middle;
}

ChoicePrompt > Container {
    width: 60%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

ChoicePrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

ChoicePrompt > Container > #description {
    color: $text-muted;
}

ChoicePrompt > Container > CheckSelectionList {
    height: 1fr;
    margin: 1 0;
    border: solid $primary-background-lighten-1 100%;
    background: $panel;
}

/* No row highlight band here at all: the checkbox alone shows selection. */
ChoicePrompt > Container > CheckSelectionList > .check-selection-list--cursor {
    background: transparent;
}

ChoicePrompt > Container > Horizontal {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 1 0 0 0;
}

ChoicePrompt > Container > Horizontal > Button {
    margin: 0 0 0 2;
}

ChoicePrompt > Container > Horizontal > Button:focus {
    text-style: none;
}

/* ---- SelectCommands: two-pane transfer list, mirrors ManageCallbacks ---- */

SelectCommands {
    align: center middle;
}

SelectCommands > Container {
    width: 90%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

SelectCommands > Container > #title {
    width: 100%;
    content-align-horizontal: center;
}

SelectCommands #panes {
    height: 1fr;
}

SelectCommands #included_pane,
SelectCommands #excluded_pane {
    width: 1fr;
    height: 100%;
}

SelectCommands #included_list,
SelectCommands #excluded_list {
    height: 1fr;
    border: solid $primary-background-lighten-1 100%;
    /* Match the option rows so the list has no inner ring/second border. */
    background: $panel;
}

SelectCommands #included_filter,
SelectCommands #excluded_filter {
    margin: 0 0 1 0;
    background: $panel;
    border: solid $primary-background-lighten-1 100%;
}

SelectCommands #included_filter:focus,
SelectCommands #excluded_filter:focus {
    background: $panel;
    border: solid $primary 100%;
}

SelectCommands Checkbox {
    border: none;
    background: $panel;
}

SelectCommands Checkbox:focus {
    background: $panel;
    background-tint: $panel 0%;
    border: none;
}

SelectCommands Checkbox:focus > .toggle--label {
    color: $text;
    background: $panel;
    text-style: none;
}

SelectCommands Checkbox > .toggle--button {
    color: $text-muted;
    background: $panel;
}

SelectCommands Checkbox.-on > .toggle--button {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

SelectCommands SelectionList > .selection-list--button,
SelectCommands SelectionList > .selection-list--button-highlighted {
    color: $text-muted;
    background: $panel;
}

SelectCommands SelectionList > .selection-list--button-selected,
SelectCommands SelectionList > .selection-list--button-selected-highlighted {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

/* Selection is shown by the checkbox only: no cursor/hover highlight band. */
SelectCommands SelectionList > .option-list--option,
SelectCommands SelectionList > .option-list--option-highlighted,
SelectCommands SelectionList > .option-list--option-hover {
    background: $panel;
    color: $text;
    text-style: none;
}

SelectCommands #move_buttons {
    width: auto;
    height: 100%;
    align: center middle;
    margin: 0 2;
}

SelectCommands #move_buttons > Button {
    width: 5;
    min-width: 5;
    margin: 1 0;
    color: $text;
    background: $panel;
    border: tall $primary-background-lighten-1;
}

SelectCommands #move_buttons > Button:hover {
    background: $primary-background-lighten-1;
    border: tall $primary-background-lighten-1;
}

SelectCommands #move_buttons > Button:focus {
    background: $panel;
    /* Keep the normal border on focus (no blue accent), and don't reverse/highlight
       the arrow glyph when the button holds focus. */
    border: tall $primary-background-lighten-1;
    text-style: none;
}

SelectCommands #actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 1 0 0 0;
}

SelectCommands #actions > Button {
    margin: 0 0 0 2;
}

SelectCommands #actions > Button:focus {
    text-style: none;
}

/* ---- ParamForm: the aggregated build/C2 parameter form ---- */

ParamForm {
    align: center middle;
}

ParamForm > #param-form {
    width: 80%;
    max-width: 110;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

ParamForm > #param-form > #form-title {
    width: 100%;
    content-align-horizontal: center;
    text-style: bold;
    color: $text;
    padding: 0 0 1 0;
    border-bottom: solid $primary-background-lighten-1;
}

ParamForm > #param-form > #fields {
    height: 1fr;
    background: $panel;
    padding: 0 1;
}

/* group section header */
ParamForm .form-section {
    width: 100%;
    text-style: bold;
    color: $accent;
    border-bottom: solid $accent-darken-1;
    margin: 1 0 0 0;
}

/* one field block: name, optional description, control, error line */
ParamForm .form-field {
    height: auto;
    width: 100%;
    margin: 1 0 0 0;
}

ParamForm .form-field > .field-label {
    width: 100%;
    text-style: bold;
    color: $text;
}

ParamForm .form-field > .field-description {
    width: 100%;
    text-style: italic;
    color: $text-muted;
}

ParamForm .form-field > .field-error {
    height: auto;
    color: $error;
    text-style: italic;
}

ParamForm .form-field > Input,
ParamForm .form-field > Select {
    width: 1fr;
    margin: 0;
}

/* themed text/number/date/file inputs, selects and text areas */
ParamForm Input,
ParamForm TextArea {
    background: $panel;
    border: solid $primary-background-lighten-1;
}

ParamForm Input:focus,
ParamForm TextArea:focus {
    border: solid $primary;
}

ParamForm Select > SelectCurrent {
    background: $panel;
    border: solid $primary-background-lighten-1;
}

ParamForm Select:focus > SelectCurrent,
ParamForm Select.-expanded > SelectCurrent {
    border: solid $primary;
}

ParamForm Select > SelectOverlay {
    background: $panel;
    border: solid $primary;
}

/* glyph checkbox (☐/☑) matching the callbacks modal — no solid-block X button */
ParamForm GlyphCheckbox {
    border: none;
    background: $panel;
    height: auto;
    padding: 0;
}

ParamForm GlyphCheckbox:focus {
    background: $panel;
    background-tint: $panel 0%;
    border: none;
}

ParamForm GlyphCheckbox:focus > .toggle--label {
    color: $text;
    background: $panel;
    text-style: none;
}

ParamForm GlyphCheckbox > .toggle--button {
    color: $text-muted;
    background: $panel;
}

ParamForm GlyphCheckbox.-on > .toggle--button {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

ParamForm .form-field > CheckSelectionList {
    height: auto;
    max-height: 6;
    border: solid $primary-background-lighten-1;
    background: $panel;
}

ParamForm .form-field > TextArea {
    height: 4;
    border: solid $primary-background-lighten-1;
    background: $panel;
}

ParamForm .form-field > .file-field {
    height: auto;
    width: 100%;
}

ParamForm .form-field > .file-field > Input {
    width: 1fr;
}

ParamForm > #param-form > Horizontal {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 1 0 0 0;
}

ParamForm > #param-form > Horizontal > Button {
    margin: 0 0 0 2;
}

/* keep the variant colour on focus; drop the default reversed-label highlight (black box) */
ParamForm > #param-form > Horizontal > Button:focus {
    text-style: none;
}

/* compact layout: name + control on one row, description in the footer help line */
ParamForm .form-field.compact {
    margin: 1 0 0 0;
}

ParamForm .compact-row {
    width: 100%;
    height: auto;
}

ParamForm .compact-row > .compact-label {
    width: 22;
    text-style: bold;
    color: $text;
    padding: 1 1 0 0;
}

ParamForm .compact-row > Input,
ParamForm .compact-row > Select {
    width: 1fr;
}

/* description line beneath a compact row: align under the control, not the name */
ParamForm .form-field.compact > .field-description {
    padding: 0 0 0 22;
}

/* ---- BuildSummary: final review before building ---- */

BuildSummary {
    align: center middle;
}

BuildSummary > #build-summary {
    width: 80%;
    max-width: 110;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

BuildSummary > #build-summary > #summary-title {
    width: 100%;
    content-align-horizontal: center;
    text-style: bold;
    color: $text;
    padding: 0 0 1 0;
    border-bottom: solid $primary-background-lighten-1;
}

BuildSummary #summary-body {
    height: 1fr;
    background: $panel;
    padding: 0 1;
}

BuildSummary Collapsible {
    background: $panel;
    border: none;
    border-top: none;
    margin: 1 0 0 0;
    padding: 0;
}

/* Don't tint the whole section when the title inside it holds focus. */
BuildSummary Collapsible:focus-within {
    background-tint: $panel 0%;
}

/* The title is just an accent-coloured heading: no block-cursor highlight bar in
   any state (the default focus/blur styles paint a full-width reverse band). */
BuildSummary CollapsibleTitle,
BuildSummary CollapsibleTitle:hover,
BuildSummary CollapsibleTitle:focus {
    background: $panel;
    background-tint: $panel 0%;
    color: $accent;
    text-style: bold;
}

/* Match the body background so the left indent reads as spacing, not a dark gutter. */
BuildSummary Collapsible > Contents {
    background: $panel;
    padding: 0 0 0 3;
}

BuildSummary Collapsible Static {
    color: $text;
    background: $panel;
}

BuildSummary #actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 1 0 0 0;
}

BuildSummary #actions > Button {
    margin: 0 0 0 2;
}

BuildSummary #actions > Button:focus {
    text-style: none;
}

/* ---- SettingsScreen: command-palette settings panel ---- */

SettingsScreen {
    align: center middle;
}

SettingsScreen > #settings-panel {
    width: 80%;
    max-width: 110;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

SettingsScreen > #settings-panel > #settings-title {
    width: 100%;
    content-align-horizontal: center;
    text-style: bold;
    color: $text;
    padding: 0 0 1 0;
    border-bottom: solid $primary-background-lighten-1;
}

SettingsScreen TabbedContent {
    height: 1fr;
}

SettingsScreen #keybindings-fields {
    height: 1fr;
    background: $panel;
    padding: 0 1;
}

SettingsScreen #theme-list {
    height: 1fr;
    background: $panel;
    border: solid $primary-background-lighten-1;
}

SettingsScreen .form-section {
    width: 100%;
    text-style: bold;
    color: $accent;
    border-bottom: solid $accent-darken-1;
    margin: 1 0 0 0;
}

SettingsScreen .keybinding-row {
    height: auto;
    width: 100%;
    margin: 1 0 0 0;
}

SettingsScreen .keybinding-input-row {
    width: 100%;
    height: auto;
}

SettingsScreen .keybinding-input-row > .keybinding-label {
    width: 32;
    text-style: bold;
    color: $text;
    padding: 1 1 0 0;
}

SettingsScreen .keybinding-input-row > .keybinding-key-display {
    width: 1fr;
    height: 3;
    content-align: left middle;
    background: $panel;
    border: solid $primary-background-lighten-1;
    padding: 0 1;
}

SettingsScreen .keybinding-input-row > .keybinding-set-button {
    margin: 0 0 0 1;
}

SettingsScreen .keybinding-input-row > .keybinding-set-button:focus {
    text-style: none;
}

SettingsScreen .field-error {
    height: auto;
    color: $error;
    text-style: italic;
}

SettingsScreen > #settings-panel > #settings-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 1 0 0 0;
}

SettingsScreen > #settings-panel > #settings-buttons > Button {
    margin: 0 0 0 2;
}

SettingsScreen > #settings-panel > #settings-buttons > Button:focus {
    text-style: none;
}

.login_screen {
    align: center middle
}

.login_box {
    align: center middle;
    height: 20;
    max-width: 50%;
    background: $panel;
    color: $text;
    border: wide $accent 100%;
    padding: 1 2;
}

.login_box > Input {
    margin: 1 0 0 0;
    border: tall $panel 100%;
    &:focus {
        text-style: bold;
    }

    &:dark {
        &:focus {
            background: $panel-lighten-1;
            border: tall $panel-lighten-3 100%;
        }

    }

    &:light {
        &:focus {
            background: $panel-darken-1;
            border: tall $panel-darken-3 100%;
        }

    }
}

.login_box > Button {
    width: 100w;
    margin: 1 0 0 0;

    &:dark {
        background: $accent;
        border: $accent;
        &:hover {
            background: $accent-lighten-1;
            border: tall $accent-lighten-3 100%;
            color: $text;
            text-style: bold;
        }
        &:focus {
            text-style: bold;
            background: $accent-lighten-1;
            border: tall $accent-lighten-3 100%;
        }
    }

    &:light {
        background: $accent-lighten-1;
        border: $accent-lighten-1;

        &:hover {
            background: $accent-darken-1;
            border: tall $accent-darken-3 100%;
            color: $text;
            text-style: bold;
        }
        &:focus {
            text-style: bold;
            background: $accent-darken-1;
            border: tall $accent-darken-3 100%;
        }
    }


}

Sidebar {
    width: 35%;
    height: 100%;
    dock: left;
    background: $panel;
    margin: 1 0;
}

Sidebar.-hidden {
    display: none;
}

SidebarModule {
    border: $accent;
    margin: 1;
    max-height: 12;
    min-height: 12;
}

TasksTable {
    height: 1fr;
    min-height: 12;
    max-height: 100%;
}

CallbackTable, TasksTable DataTable {
    background: $panel;
}

CallbackTable > .datatable--header, TasksTable DataTable > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

CallbackTable > .datatable--odd-row, TasksTable DataTable > .datatable--odd-row {
    background: $panel;
}

CallbackTable > .datatable--even-row, TasksTable DataTable > .datatable--even-row {
    background: $panel-lighten-1;
}

CallbackTable > .datatable--cursor, TasksTable DataTable > .datatable--cursor {
    background: $primary 25%;
}

CallbackTable > .datatable--hover, TasksTable DataTable > .datatable--hover {
    background: $panel-lighten-1 50%;
}

SessionInfo {
    border: $accent;
    margin: 1;
    max-height: 15;
    border-title-align: left;
}

ConsolePanel > Container > Vertical > ConsoleInput {
    height: auto;
    min-height: 3;
    max-height: 10;
    content-align: left middle;
    dock: bottom;
    border: solid $background-lighten-3 100%;
    padding: 0 1;
    &:focus {
        border: solid $primary-background-lighten-3 100%;
    }
}

YesNoPrompt {
    align: center middle;
}

YesNoPrompt > Container {
    width: auto;
    height: auto;
    padding: 1 2;
    background: $panel;
}

YesNoPrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

YesNoPrompt > Container > Horizontal {
    width: auto;
    height: auto;
}

YesNoPrompt > Container > Horizontal > Button {
    margin: 1 0 0 0;
}

FilePrompt {
    align: center middle;
}

FilePrompt > Container {
    width: 80%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

FilePrompt > Container > Label {
    width: 100%;
    content-align-horizontal: center;
    padding: 0 1;
}

FilePrompt > Container > DirectoryTree {
    width: 100%;
    height: 1fr;
    border: solid $primary-background-lighten-1 100%;
    margin: 1 0;
}

FilePrompt > Container > Horizontal {
    width: auto;
    height: auto;
}

FilePrompt > Container > Horizontal > Button {
    margin: 1 0 0 0;
}

ManageCallbacks {
    align: center middle;
}

ManageCallbacks > Container {
    width: 90%;
    height: 80%;
    padding: 1 2;
    background: $panel;
}

ManageCallbacks > Container > #title {
    width: 100%;
    content-align-horizontal: center;
}

ManageCallbacks #panes {
    height: 1fr;
}

ManageCallbacks #shown_pane,
ManageCallbacks #hidden_pane {
    width: 1fr;
    height: 100%;
}

ManageCallbacks #shown_list,
ManageCallbacks #hidden_list {
    height: 1fr;
    border: solid $primary-background-lighten-1 100%;
    /* Match the option rows so the list has no inner ring/second border. */
    background: $panel;
}

ManageCallbacks #shown_filter,
ManageCallbacks #hidden_filter {
    margin: 0 0 1 0;
    background: $panel;
    border: solid $primary-background-lighten-1 100%;
}

ManageCallbacks #shown_filter:focus,
ManageCallbacks #hidden_filter:focus {
    background: $panel;
    border: solid $primary 100%;
}

ManageCallbacks #shown_header,
ManageCallbacks #hidden_header {
    color: $text-muted;
    text-style: bold;
    margin: 0;
    /* Match the list's left border (1) + option padding (1) so the header
       columns line up with the rows below. */
    padding: 0 0 0 2;
}

ManageCallbacks Checkbox {
    border: none;
    background: $panel;
}

ManageCallbacks Checkbox:focus {
    background: $panel;
    background-tint: $panel 0%;
    border: none;
}

ManageCallbacks Checkbox:focus > .toggle--label {
    color: $text;
    background: $panel;
    text-style: none;
}

ManageCallbacks Checkbox > .toggle--button {
    color: $text-muted;
    background: $panel;
}

ManageCallbacks Checkbox.-on > .toggle--button {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

ManageCallbacks SelectionList > .selection-list--button,
ManageCallbacks SelectionList > .selection-list--button-highlighted {
    color: $text-muted;
    background: $panel;
}

ManageCallbacks SelectionList > .selection-list--button-selected,
ManageCallbacks SelectionList > .selection-list--button-selected-highlighted {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

/* Selection is shown by the checkbox only: no cursor/hover highlight band. */
ManageCallbacks SelectionList > .option-list--option,
ManageCallbacks SelectionList > .option-list--option-highlighted,
ManageCallbacks SelectionList > .option-list--option-hover {
    background: $panel;
    color: $text;
    text-style: none;
}

ManageCallbacks #move_buttons {
    width: auto;
    height: 100%;
    align: center middle;
    margin: 0 2;
}

ManageCallbacks #move_buttons > Button {
    width: 5;
    min-width: 5;
    margin: 1 0;
    color: $text;
    background: $panel;
    border: tall $primary-background-lighten-1;
}

ManageCallbacks #move_buttons > Button:hover {
    background: $primary-background-lighten-1;
    border: tall $primary-background-lighten-1;
}

ManageCallbacks #move_buttons > Button:focus {
    background: $panel;
    /* Keep the normal border on focus (no blue accent), and don't
       reverse/highlight the arrow glyph when the button holds focus. */
    border: tall $primary-background-lighten-1;
    text-style: none;
}

ManageCallbacks #actions {
    width: auto;
    height: auto;
    align: center middle;
}

ManageCallbacks #actions > Button {
    margin: 1 1 0 1;
}

ConsoleOutput {
    width: 1fr;
    height: 1fr;

    &:dark {
        border: solid $primary-background-lighten-1 100%;
    }

    &:light {
        border: solid $background-darken-1;
    }
}

CallbackTabs {
    background: $surface;
    & > ContentTabs {
        background: $surface;
    }
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface-lighten-1 50%;
    scrollbar-background-active: $surface-lighten-1 50%;
    scrollbar-color: $surface;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-corner-color: $surface;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

.-scrolling {
    scrollbar-background: $surface-lighten-1 50%;
    scrollbar-color: $primary;
    scrollbar-size-vertical: 2;
    scrollbar-size-horizontal: 1;
}

Sidebar VerticalScroll, CallbackTable, TasksTable DataTable {
    scrollbar-background: $panel;
    scrollbar-background-hover: $panel-lighten-1 50%;
    scrollbar-background-active: $panel-lighten-1 50%;
    scrollbar-color: $panel;
    scrollbar-corner-color: $panel;
}

Sidebar VerticalScroll.-scrolling, CallbackTable.-scrolling, TasksTable DataTable.-scrolling {
    scrollbar-background: $panel-lighten-1 50%;
    scrollbar-color: $primary;
}
